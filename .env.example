# Copy to .env and fill in. Never commit .env, and never put real keys in this file.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Langfuse tracing (free Hobby tier at cloud.langfuse.com). Tracing is off if these are empty.

LANGFUSE_HOST=https://cloud.langfuse.com

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Optional overrides (defaults live in levi/config.py)
# LEVI_EMBED_MODEL=BAAI/bge-base-en-v1.5
# LEVI_RERANK_MODEL=BAAI/bge-reranker-base
# LEVI_CHUNK_WORDS=200
# LEVI_CHUNK_OVERLAP=40
